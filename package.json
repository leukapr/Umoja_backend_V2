{
  "name": "umoja-back-v2",
  "version": "1.0.0",
  "description": "Plateforme de recrutement moderne avec TypeScript",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "npm run clean && tsc",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "echo 'Add ESLint here'",
    "format": "echo 'Add Prettier here'",
    "db:seed": "NODE_ENV=development tsx src/db/seeders.ts",
    "postinstall": "npm run build",
    "dev:inspect": "nodemon --inspect",
    "test": "echo 'Add tests with Jest/Vitest'",
    "test:watch": "echo 'Add test watch mode'",
    "migrate": "echo 'Add migration script'",
    "db:reset": "NODE_ENV=development tsx -r dotenv/config src/db/reset.ts"
  },
  "keywords": [
    "recrutement",
    "api",
    "express",
    "typescript",
    "rest-api",
    "france-travail"
  ],
  "author": "Royce",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.7",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.2",
    "mariadb": "^3.4.5",
    "sequelize": "^6.37.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.9.1",
    "@types/sequelize": "^4.28.20",
    "nodemon": "^3.1.10",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
