# Server
PORT=3500
NODE_ENV=development

# Database
DB_NAME=umoja_recrutement
DB_USER=root
DB_PASSWORD=your_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# Security
JWT_SECRET=your_super_secret_key_minimum_32_characters_random

# CORS
CORS_ORIGIN=http://localhost:3000

# France Travail API
FRANCE_TRAVAIL_CLIENT_ID=your_client_id
FRANCE_TRAVAIL_CLIENT_SECRET=your_client_secret
FRANCE_TRAVAIL_SCOPE=api_offresdemploiv2 o2dsoffre
FRANCE_TRAVAIL_TOKEN_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=/partenaire